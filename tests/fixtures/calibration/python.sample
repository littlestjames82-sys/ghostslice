"""Inventory helpers for a small warehouse tool (calibration sample)."""
from __future__ import annotations

import json
from dataclasses import dataclass, field
from pathlib import Path


@dataclass
class Item:
    sku: str
    name: str
    quantity: int = 0
    location: str = "unsorted"
    tags: list[str] = field(default_factory=list)

    def label(self) -> str:
        return f"{self.sku}: {self.name} ({self.quantity} @ {self.location})"


class Inventory:
    """A tiny in-memory inventory with JSON persistence."""

    def __init__(self) -> None:
        self._items: dict[str, Item] = {}

    def add(self, item: Item) -> None:
        existing = self._items.get(item.sku)
        if existing is None:
            self._items[item.sku] = item
        else:
            existing.quantity += item.quantity

    def remove(self, sku: str, count: int = 1) -> bool:
        item = self._items.get(sku)
        if item is None or item.quantity < count:
            return False
        item.quantity -= count
        return True

    def low_stock(self, threshold: int = 5) -> list[Item]:
        return [i for i in self._items.values() if i.quantity < threshold]

    def save(self, path: Path) -> None:
        data = {sku: vars(item) for sku, item in self._items.items()}
        path.write_text(json.dumps(data, indent=2), encoding="utf-8")

    @classmethod
    def load(cls, path: Path) -> "Inventory":
        inv = cls()
        raw = json.loads(path.read_text(encoding="utf-8"))
        for sku, fields in raw.items():
            inv._items[sku] = Item(**fields)
        return inv


def summarise(inv: Inventory) -> str:
    total = sum(i.quantity for i in inv._items.values())
    kinds = len(inv._items)
    return f"{kinds} kinds, {total} units"
