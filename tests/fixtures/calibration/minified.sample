"use strict";const T={low:22.5,high:68},pct=(v,of)=>Math.round(1e3*(v/of))/10;function band(v){return v<T.low?"dry":v>T.high?"wet":"ok"}function createLog(limit){const readings=[];return{push(value){readings.push({at:Date.now(),value:value,band:band(value)});if(readings.length>limit)readings.shift()},summary(){if(!readings.length)return null;const vals=readings.map(r=>r.value),min=Math.min.apply(null,vals),max=Math.max.apply(null,vals),avg=vals.reduce((a,b)=>a+b,0)/vals.length;return{min:min,max:max,avg:Math.round(100*avg)/100,percentOfRange:pct(avg,T.high),count:readings.length,latest:readings[readings.length-1]}}}}module.exports={thresholds:T,bandFor:band,createLog:createLog};
