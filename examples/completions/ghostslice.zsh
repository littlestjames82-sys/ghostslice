# GhostSlice shell completions for zsh.
# Generated by `ghostslice completions zsh` from the
# live argument parser; do not edit by hand — regenerate.
# Token counts everywhere in GhostSlice output are estimates.
#compdef ghostslice

_ghostslice() {
    local -a commands
    commands=(
        'cache'
        'calibrate'
        'calls'
        'check'
        'check-budget'
        'ci'
        'completions'
        'diff'
        'doctor'
        'explain'
        'export'
        'graph'
        'history'
        'init'
        'lint'
        'mcp'
        'prices'
        'report'
        'scan'
        'secrets'
        'serve'
        'slice'
        'symbols'
        'task'
        'watch'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'ghostslice command' commands
        return
    fi
    case "$words[2]" in
        cache)
            if (( CURRENT == 3 )); then
                local -a subs
                subs=(
                    'clear'
                    'stats'
                )
                _describe -t subcommands 'subcommand' subs
                return
            fi
            case "$words[3]" in
                clear)
                    _arguments '-h' '--help'
                    ;;
                stats)
                    _arguments '-h' '--help' '--json'
                    ;;
            esac
            ;;
        calibrate)
            _arguments '-h' '--help' '--json'
            ;;
        calls)
            _arguments '-h' '--help' '--json' '--dead' '--no-cache'
            ;;
        check)
            _arguments '-h' '--help'
            ;;
        check-budget)
            _arguments '-h' '--help' '--max-tokens' '--mode'
            ;;
        ci)
            _arguments '-h' '--help' '--budget' '--strict' '--allow-secrets' '--fail-on-secrets' '--json' '--pr-comment' '--out'
            ;;
        completions)
            _arguments '-h' '--help'
            ;;
        diff)
            _arguments '-h' '--help' '--json'
            ;;
        doctor)
            _arguments '-h' '--help' '--json'
            ;;
        explain)
            _arguments '-h' '--help' '--mode'
            ;;
        export)
            _arguments '-h' '--help' '-o' '--out' '--mode' '--preset' '--model' '--exclude-secrets' '--redact' '--no-redact' '--auto-shrink' '--fit' '--symbols' '--timing' '--no-cache' '--workers' '--plugin' '--allow-plugin-override'
            ;;
        graph)
            _arguments '-h' '--help' '--json'
            ;;
        history)
            _arguments '-h' '--help' '--json' '--trend' '--model'
            ;;
        init)
            _arguments '-h' '--help' '--yes' '--force' '--dry-run' '--budget' '--model'
            ;;
        lint)
            _arguments '-h' '--help' '--json' '--strict' '--no-cache'
            ;;
        mcp)
            _arguments '-h' '--help'
            ;;
        prices)
            _arguments '-h' '--help'
            ;;
        report)
            _arguments '-h' '--help' '-o' '--out' '--model'
            ;;
        scan)
            _arguments '-h' '--help' '--json' '--top' '--model' '--timing' '--no-cache'
            ;;
        secrets)
            _arguments '-h' '--help' '--json'
            ;;
        serve)
            _arguments '-h' '--help' '--port' '--host'
            ;;
        slice)
            _arguments '-h' '--help' '--mode' '-o' '--out' '--no-cache' '--plugin' '--allow-plugin-override'
            ;;
        symbols)
            _arguments '-h' '--help' '--json'
            ;;
        task)
            _arguments '-h' '--help' '--task' '--diff' '--budget' '--fit' '-o' '--out' '--preset' '--model' '--redact' '--no-redact' '--plugin' '--allow-plugin-override'
            ;;
        watch)
            _arguments '-h' '--help' '-o' '--out' '--export' '--interval' '--debounce' '--once' '--max-events' '--mode' '--preset' '--exclude-secrets' '--redact' '--no-redact' '--auto-shrink' '--fit' '--plugin' '--allow-plugin-override'
            ;;
    esac
}

_ghostslice "$@"
# Top-level flags (before the subcommand): -h --help --version
